{
  "name": "zekeriyaay-com",
  "version": "2.0.0",
  "description": "Personal portfolio website built with Hugo and Tailwind CSS",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify",
    "css:dev": "npx tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --watch",
    "css:build": "npx tailwindcss -i ./assets/css/main.css -o ./assets/css/output.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0"
  },
  "browserslist": [
    "defaults"
  ]
}
